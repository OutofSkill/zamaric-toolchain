# Vorlage: als .env in denselben Ordner kopieren und ausfüllen.
# Die .env kommt nicht ins Repo (siehe .gitignore).

# Supabase-Dashboard → Project Settings → API. Beides ist kein Secret.
SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# E-Mail des Upload-Accounts. Im Browser wird nur das Passwort eingegeben.
ADMIN_EMAIL=

# Eigene Adresse der Website im NetBird-Netz, ohne / am Ende
PUBLIC_ORIGIN=http://zamaric-upload.netbird.cloud

# Session endet nach so vielen Minuten ohne Anfrage
SESSION_IDLE_MINUTES=120

# NetBird-Dashboard → Setup Keys (einmalig verwendbar).
# Nur für den ersten Start, danach wieder leeren.
NB_SETUP_KEY=
